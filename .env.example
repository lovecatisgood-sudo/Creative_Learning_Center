# ─── Database (Neon Postgres) ───────────────────────────────────────────────
# Neon pooled connection string. Works with node-postgres (`pg`) on both a
# Hostinger VPS and Vercel unchanged.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/sccc?sslmode=require

# ─── Admin auth (single shared credential) ──────────────────────────────────
ADMIN_EMAIL=admin@siamesecatclub.com
# bcrypt hash — generate with: pnpm create-admin
ADMIN_PASSWORD_HASH=
# Secret for iron-session cookie encryption. Must be at least 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Separate encryption key for the customer member-session cookie. Do not reuse
# the admin secret in production.
MEMBER_SESSION_SECRET=change-me-to-a-different-random-string-32-chars

# Public origin used to construct member verification and purchase-claim links.
APP_ORIGIN=https://creative.siamesecat.cafe

# Version identifiers recorded with member consent. Update these when the
# published legal text changes.
TERMS_VERSION=2026-08-11
PRIVACY_VERSION=2026-08-11

# Google Identity Services Web client ID. Add https://creative.siamesecat.cafe
# as an authorized JavaScript origin in Google Cloud Console.
GOOGLE_CLIENT_ID=
# General-audience Google login for saving a player profile and recreational
# scores. Set true only after GOOGLE_CLIENT_ID is configured in production.
GAME_LOGIN_ENABLED=false

# First-party game-over video campaigns. Disabled by default; when enabled, the
# fill percentage controls how often an eligible break receives a house ad.
HOUSE_ADS_ENABLED=false
HOUSE_AD_FILL_PERCENT=35

# GameAnalytics Web/HTML5 credentials. The route exposes these to the browser,
# as required by the client SDK; never reuse server, mobile, or account secrets.
GAMEANALYTICS_GAME_KEY=
GAMEANALYTICS_SECRET_KEY=
GAMEANALYTICS_BUILD=web-1.0.0
GAMEANALYTICS_ANDROID_GAME_KEY=
GAMEANALYTICS_ANDROID_SECRET_KEY=
GAMEANALYTICS_ANDROID_BUILD=android-1.0.0
GAMEANALYTICS_IOS_GAME_KEY=
GAMEANALYTICS_IOS_SECRET_KEY=
GAMEANALYTICS_IOS_BUILD=ios-1.0.0

# Native AdMob bridge. Test mode uses Google's demo ad units automatically.
# Never publish until test mode is false and both production unit IDs are set.
ADMOB_TEST_MODE=true
ADMOB_ANDROID_INTERSTITIAL_ID=
ADMOB_IOS_INTERSTITIAL_ID=

# ─── Blog publishing integration ───────────────────────────────────────────
# Server-to-server bearer token for the Thai/English blog posting APIs.
# Generate with: openssl rand -hex 32
BLOG_PUBLISH_API_KEY=

# ─── PromptPay / bank (payment display) ─────────────────────────────────────
# Phone number (0812345678) or 13-digit citizen ID used to generate the QR.
PROMPTPAY_ID=0812345678
BANK_NAME=Kasikornbank
BANK_ACCOUNT_NAME=Siamese Cat Creative Club Co., Ltd.
BANK_ACCOUNT_NUMBER=123-4-56789-0

# ─── File storage (payment-proof photos) ────────────────────────────────────
# Directory on the server disk where uploaded proof photos are written.
UPLOAD_DIR=/var/sccc/uploads

# --- Contact form email delivery -------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=Cafe@siamesecat.cafe
# Use a revocable mailbox app password; never commit the real value.
SMTP_PASSWORD=
CONTACT_TO_EMAIL=Cafe@siamesecat.cafe

# ─── Public config (exposed to the browser) ─────────────────────────────────
# Signup consent links now point at the app's own /terms and /privacy pages;
# these absolute URLs are kept for reference / external use only.
NEXT_PUBLIC_TERMS_URL=https://creative.siamesecat.cafe/terms
NEXT_PUBLIC_PRIVACY_URL=https://creative.siamesecat.cafe/privacy
NEXT_PUBLIC_SHOP_NAME="Siamese Cat Creative Club"
# Legal entity name, shown on the printed receipt under the shop brand line.
NEXT_PUBLIC_COMPANY_NAME="Siamese Cat Cafe Co., Ltd. (Thailand)"
