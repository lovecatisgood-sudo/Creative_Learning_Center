{
  "name": "sccc-management-system",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/optimize-main-site-images.mjs && node scripts/build-main-site-redesign.mjs && node scripts/build-family-tools.mjs && node scripts/check-main-site-shell.mjs && node scripts/check-family-tools.mjs && node scripts/build-legal.mjs",
    "build": "next build",
    "hostinger:build": "pnpm db:migrate && pnpm build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "signup-qr": "tsx scripts/signup-qr.ts",
    "images:landing": "node scripts/optimize-landing-images.mjs",
    "legal:build": "node scripts/build-legal.mjs",
    "check:main-site-shell": "node scripts/check-main-site-shell.mjs",
    "check:family-tools": "node scripts/check-family-tools.mjs",
    "check:game-features": "node scripts/check-game-features.mjs",
    "check:deploy-hygiene": "node scripts/check-deploy-hygiene.mjs",
    "qa:layout": "node scripts/qa-layout.mjs",
    "security:check": "pnpm audit && pnpm check:deploy-hygiene"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^11.0.0",
    "html-to-image": "^1.11.13",
    "iron-session": "^8.0.4",
    "next": "15.5.23",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.3",
    "autoprefixer": "^10.5.4",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "marked": "12.0.2",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  },
  "overrides": {
    "browserslist": "4.24.4",
    "caniuse-lite": "1.0.30001692"
  }
